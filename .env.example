MATRIX_PORT=8110

# Academy voice (screen + audio only — no avatar teacher)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Live market data — https://twelvedata.com (not twelve-data.com)
# TWELVE_DATA_API_KEY=
# optional separate WS key (falls back to API key if unset)
# TWELVE_DATA_WS_KEY=
# TWELVE_DATA_WS_SYMBOLS=EUR/USD,GBP/USD,XAU/USD
# shared = light on quota when robot uses same key
# TWELVE_DATA_CACHE_MODE=shared

# AI assistant (optional — falls back to local heuristic)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
